{
  "name": "content-blocker-agent",
  "version": "1.4.0",
  "description": "Local Windows agent: blocks video/movie apps and reports to the dashboard",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build": "pkg . --targets node18-win-x64 --output dist/content-blocker-agent.exe"
  },
  "dependencies": {
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [],
    "targets": ["node18-win-x64"],
    "outputPath": "dist"
  }
}
