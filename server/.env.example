# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the service settings instead.

# Paste the "Service URI" from your Aiven Valkey/Redis console
# (Connect with: General -> Service URI). It looks like:
#   rediss://default:PASSWORD@host:port
REDIS_URL=rediss://default:PASSWORD@your-valkey-host.aivencloud.com:15121

ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=some-random-long-string
PORT=3000
